{
  "name": "fashion-canvas",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "expo run:android --device --variant release",
    "android:build": "eas build --platform android --profile preview",
    "android:build:apk": "eas build --platform android --profile production-apk",
    "android:build:store": "eas build --platform android --profile production",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "ios:build": "eas build --platform ios --profile preview",
    "ios:build:release": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --latest",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint . --max-warnings=0",
    "lint:fix": "expo lint . --fix",
    "build": "expo export --platform web --output-dir dist",
    "test": "node --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=97 --test-coverage-functions=100 --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "57.0.6",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "serve": "^14.2.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
